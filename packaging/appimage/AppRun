#!/bin/sh
HERE="$(dirname "$(readlink -f "$0")")"
export APPDIR="${APPDIR:-$HERE}"

export LD_LIBRARY_PATH="$APPDIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export XDG_DATA_DIRS="$APPDIR/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export GSETTINGS_SCHEMA_DIR="$APPDIR/usr/share/glib-2.0/schemas"
# Host GIO modules are built against the host's GLib; don't load them.
export GIO_MODULE_DIR="$APPDIR/usr/lib/gio/modules"
export GTK_PATH="$APPDIR/usr/lib/gtk-4.0"
export GTK_EXE_PREFIX="$APPDIR/usr"
export GTK_DATA_PREFIX="$APPDIR/usr"

# gdk-pixbuf needs absolute loader paths; write the cache per user.
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/aloft"
mkdir -p "$CACHE"
sed "s|@APPDIR_LOADERS@|$APPDIR/usr/lib/gdk-pixbuf-2.0/loaders|g" \
	"$APPDIR/usr/lib/gdk-pixbuf-2.0/loaders.cache.in" >"$CACHE/pixbuf-loaders.cache"
export GDK_PIXBUF_MODULE_FILE="$CACHE/pixbuf-loaders.cache"

# GStreamer: bundled plugins only, own registry (the host's is for its own
# GStreamer version).
export GST_PLUGIN_SYSTEM_PATH_1_0="$APPDIR/usr/lib/gstreamer-1.0"
export GST_PLUGIN_PATH_1_0="$APPDIR/usr/lib/gstreamer-1.0"
export GST_PLUGIN_SCANNER_1_0="$APPDIR/usr/libexec/gstreamer-1.0/gst-plugin-scanner"
export GST_PLUGIN_SCANNER="$GST_PLUGIN_SCANNER_1_0"
export GST_REGISTRY_1_0="$CACHE/gst-registry-$(basename "${APPIMAGE:-aloft}").bin"

# VA-API drivers live in different places on different distros.
if [ -z "${LIBVA_DRIVERS_PATH:-}" ]; then
	for d in /usr/lib/x86_64-linux-gnu/dri /usr/lib64/dri /usr/lib/dri /usr/lib/x86_64-linux-gnu/dri-nonfree /run/opengl-driver/lib/dri; do
		[ -d "$d" ] && LIBVA_DRIVERS_PATH="${LIBVA_DRIVERS_PATH:+$LIBVA_DRIVERS_PATH:}$d"
	done
	[ -n "${LIBVA_DRIVERS_PATH:-}" ] && export LIBVA_DRIVERS_PATH
fi

exec "$APPDIR/usr/bin/aloft" "$@"
